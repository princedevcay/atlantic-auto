{
  "name": "atlantic-auto",
  "private": true,
  "description": "Front-end build for the Atlantic Auto website: Tailwind CSS, self-hosted fonts and icons.",
  "scripts": {
    "build": "npm run build:assets && npm run build:css",
    "build:assets": "node scripts/copy-assets.mjs",
    "build:css": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --minify",
    "watch:css": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@tailwindcss/cli": "4.3.4",
    "lucide-static": "1.73.0",
    "simple-icons": "16.36.0",
    "tailwindcss": "4.3.4"
  }
}
