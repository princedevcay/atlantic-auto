{
    "name": "princedevcay/atlantic-auto",
    "description": "Website for Atlantic Auto and Shipping Services, a Ghanaian company importing vehicles from the USA: import quote and vehicle update requests, team-managed tracking pages, and a staff admin.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "bacon/bacon-qr-code": "^3.0",
        "phpmailer/phpmailer": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress"
    }
}
