# Only public/ is reachable from the web (CTL-CFG-001, CTL-CRY-001).
Options -Indexes -MultiViews
RewriteEngine On

# HTTPS only, and one canonical host without www. Redirects use the path from the original
# request line (THE_REQUEST), because REQUEST_URI may already carry the internal /public/ prefix.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{THE_REQUEST} ^\S+\s([^?\s]+)
RewriteRule ^ https://%{HTTP_HOST}%1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} ^\S+\s([^?\s]+)
RewriteCond %1::%{HTTP_HOST} ^(.*)::www\.(.+)$ [NC]
RewriteRule ^ https://%2%1 [R=301,L,NE]

# No dotfiles, no server error_log files, and no PHP file other than the front controller.
RewriteRule (^|/)\. - [R=404,L]
RewriteRule (^|/)error_log$ - [R=404,L]
RewriteCond %{REQUEST_FILENAME} \.php$ [NC]
RewriteCond %{REQUEST_FILENAME} !/index\.php$
RewriteRule ^ - [R=404,L]

# Real files (CSS, JS, fonts, images) are served directly; everything else goes to index.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg|png|webp|jpg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
